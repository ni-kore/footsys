{
  "$comment": "Design-Tokens für footsys. Einzige Quelle der Wahrheit für Farben, Abstände, Radien, Typografie. Abgeleitet aus design/reference/tactics-ui-reference.webp. Werte sind bewusst technologie-neutral (Hex/Zahlen), damit sie sowohl nach TypeScript/CSS als auch nach Swift exportiert werden können.",

  "color": {
    "bg": {
      "root": "#08080B",
      "canvas": "#0B0B10",
      "sidebar": "#0E0E14",
      "rail": "#09090D"
    },
    "surface": {
      "1": "#121218",
      "2": "#16161F",
      "3": "#1C1C27",
      "hover": "#20202C",
      "pressed": "#262634"
    },
    "border": {
      "subtle": "#1B1B24",
      "default": "#242430",
      "strong": "#33334A",
      "focus": "#5B5BF6"
    },
    "text": {
      "primary": "#ECECF3",
      "secondary": "#9A9AAD",
      "muted": "#6B6B7C",
      "disabled": "#45455A",
      "onAccent": "#FFFFFF"
    },
    "accent": {
      "base": "#5B5BF6",
      "hover": "#6E6EF8",
      "pressed": "#4A4AE0",
      "subtle": "#1E1E3D",
      "onSubtle": "#9A9AFF",
      "ring": "#5B5BF6"
    },
    "status": {
      "positive": "#37D67A",
      "positiveSubtle": "#0F2A1C",
      "warning": "#F5A524",
      "warningSubtle": "#2C2110",
      "negative": "#FF3B6B",
      "negativeSubtle": "#2E1019",
      "info": "#4CC2FF",
      "infoSubtle": "#0F2430"
    },
    "meter": {
      "low": "#37D67A",
      "medium": "#F5A524",
      "high": "#FF3B6B",
      "empty": "#26263480"
    },
    "pitch": {
      "bg": "#0D0D13",
      "line": "#2A2A38",
      "lineActive": "#5B5BF6",
      "guide": "#5B5BF64D",
      "player": "#7B7BFF",
      "playerSelected": "#FFFFFF",
      "opponent": "#4A4A5C"
    },
    "rating": {
      "$comment": "Farbskala für OVR/Bewertungen, greift auch bei Vereins-Reputation.",
      "elite": "#37D67A",
      "strong": "#9BD637",
      "average": "#F5A524",
      "weak": "#FF7A3B",
      "poor": "#FF3B6B"
    }
  },

  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "pill": 999 },

  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40, "9": 48, "10": 64 },

  "typography": {
    "$comment": "Größen in pt. iOS: SF Pro. Web-Prototyp: Inter. Dynamic Type skaliert alles außer 'micro'.",
    "fontFamily": { "ios": "SF Pro", "web": "Inter, system-ui, sans-serif", "numeric": "SF Pro / Inter — tabular-nums" },
    "style": {
      "micro":       { "size": 10, "weight": 600, "tracking": 0.8, "case": "upper", "color": "text.muted" },
      "label":       { "size": 11, "weight": 600, "tracking": 0.6, "case": "upper", "color": "text.secondary" },
      "caption":     { "size": 12, "weight": 400, "tracking": 0,   "color": "text.secondary" },
      "body":        { "size": 14, "weight": 400, "tracking": 0,   "color": "text.primary" },
      "bodyStrong":  { "size": 14, "weight": 600, "tracking": 0,   "color": "text.primary" },
      "title":       { "size": 17, "weight": 600, "tracking": -0.2, "color": "text.primary" },
      "headline":    { "size": 22, "weight": 700, "tracking": -0.4, "color": "text.primary" },
      "display":     { "size": 34, "weight": 700, "tracking": -0.8, "color": "text.primary", "numeric": true },
      "statValue":   { "size": 28, "weight": 700, "tracking": -0.5, "numeric": true }
    }
  },

  "elevation": {
    "card":  { "shadow": "0 1px 2px rgba(0,0,0,0.4)", "border": "border.subtle" },
    "raised":{ "shadow": "0 8px 24px rgba(0,0,0,0.5)", "border": "border.default" },
    "modal": { "shadow": "0 24px 64px rgba(0,0,0,0.7)", "border": "border.strong" }
  },

  "motion": {
    "$comment": "Kurz und beiläufig. Die Saison-Simulation ist die einzige Stelle mit bewusst längerer Animation.",
    "duration": { "instant": 80, "fast": 140, "base": 220, "slow": 360, "seasonTick": 650 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "spring": { "response": 0.35, "dampingFraction": 0.82 }
    }
  },

  "component": {
    "card":            { "radius": "lg", "padding": 16, "bg": "surface.1", "border": "border.subtle" },
    "segmentedControl":{ "radius": "md", "height": 34, "bg": "surface.2", "selectedBg": "accent.subtle", "selectedText": "accent.onSubtle", "text": "text.secondary" },
    "toggle":          { "width": 44, "height": 26, "knob": 22, "onBg": "accent.base", "offBg": "surface.3", "knobColor": "#FFFFFF" },
    "button": {
      "primary":   { "radius": "md", "height": 36, "bg": "accent.base", "text": "text.onAccent" },
      "secondary": { "radius": "md", "height": 36, "bg": "surface.2", "text": "text.primary", "border": "border.default" },
      "ghost":     { "radius": "md", "height": 36, "bg": "transparent", "text": "text.secondary" },
      "minHitArea": 44
    },
    "meter":  { "$comment": "5 Segmente wie in der Referenz.", "steps": 5, "segmentWidth": 6, "segmentHeight": 16, "gap": 3, "radius": "xs" },
    "ring":   { "size": 40, "trackWidth": 3, "trackColor": "surface.3" },
    "listRow":{ "minHeight": 56, "padding": 12, "radius": "md", "bg": "surface.1" },
    "chip":   { "radius": "pill", "height": 24, "paddingX": 10, "bg": "surface.2", "text": "text.secondary" }
  },

  "layout": {
    "$comment": "Breakpoints in pt (Portrait-Breite). Siehe design/DESIGN.md für das Verhalten je Klasse.",
    "breakpoint": { "compact": 0, "medium": 600, "expanded": 840, "large": 1024 },
    "maxContentWidth": 1280,
    "gutter": { "compact": 16, "medium": 20, "expanded": 24 },
    "columns": { "compact": 1, "medium": 2, "expanded": 3 },
    "tabBarHeight": 49,
    "navBarHeight": 44
  }
}
