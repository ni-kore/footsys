      "segmentHeight": 16,
      "gap": 3,
      "radius": "xs"
    },
    "ring": {
      "size": 40,
      "trackWidth": 3,
      "trackColor": "surface.3"
    },
    "listRow": {
      "minHeight": 56,
      "padding": 12,
      "radius": "md",
      "bg": "surface.1"
    },
    "chip": {
      "radius": "pill",
      "height": 24,
      "paddingX": 10,
      "bg": "surface.2",
      "text": "text.secondary"
    }
  },
  "layout": {
    "$comment": "Breakpoints in pt (Portrait-Breite). Siehe design/DESIGN.md für das Verhalten je Klasse.",
    "breakpoint": {
      "compact": 0,
      "medium": 600,
      "expanded": 840,
      "large": 1024
    },
    "maxContentWidth": 1280,
    "gutter": {
      "compact": 16,
      "medium": 20,
      "expanded": 24
    },
    "columns": {
      "compact": 1,
      "medium": 2,
      "expanded": 3
    },
    "tabBarHeight": 49,
    "navBarHeight": 44
  },
  "$brand": "Markenfarben: Grün #1FBD4B hell und #19492A dunkel, dazu zwei Schwarztöne — #17171C für Flächen und Felder, #101014 als Hintergrund darum herum."
}
