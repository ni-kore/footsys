      "knobColor": "#FFFFFF"
    },
    "button": {
      "primary": {
        "radius": "md",
        "height": 36,
        "bg": "accent.base",
        "text": "text.onAccent"
      },
      "secondary": {
        "radius": "md",
        "height": 36,
        "bg": "surface.2",
        "text": "text.primary",
        "border": "border.default"
      },
      "ghost": {
        "radius": "md",
        "height": 36,
        "bg": "transparent",
        "text": "text.secondary"
      },
