  "typography": {
    "$comment": "Größen in pt. iOS: SF Pro. Web-Prototyp: Inter. Dynamic Type skaliert alles außer 'micro'.",
    "fontFamily": {
      "ios": "SF Pro",
      "web": "Inter, system-ui, sans-serif",
      "numeric": "SF Pro / Inter — tabular-nums"
    },
    "style": {
      "micro": {
        "size": 10,
        "weight": 600,
        "tracking": 0.8,
        "case": "upper",
        "color": "text.muted"
      },
      "label": {
        "size": 11,
        "weight": 600,
        "tracking": 0.6,
        "case": "upper",
        "color": "text.secondary"
      },
      "caption": {
        "size": 12,
        "weight": 400,
        "tracking": 0,
        "color": "text.secondary"
      },
      "body": {
        "size": 14,
        "weight": 400,
        "tracking": 0,
        "color": "text.primary"
      },
      "bodyStrong": {
        "size": 14,
        "weight": 600,
        "tracking": 0,
        "color": "text.primary"
      },
      "title": {
        "size": 17,
        "weight": 600,
        "tracking": -0.2,
        "color": "text.primary"
      },
      "headline": {
        "size": 22,
        "weight": 700,
        "tracking": -0.4,
        "color": "text.primary"
      },
      "display": {
        "size": 34,
        "weight": 700,
        "tracking": -0.8,
        "color": "text.primary",
        "numeric": true
      },
      "statValue": {
        "size": 28,
        "weight": 700,
        "tracking": -0.5,
        "numeric": true
      }
    }
  },
  "elevation": {
    "card": {
      "shadow": "0 1px 2px rgba(0,0,0,0.4)",
      "border": "border.subtle"
    },
    "raised": {
      "shadow": "0 8px 24px rgba(0,0,0,0.5)",
      "border": "border.default"
    },
    "modal": {
      "shadow": "0 24px 64px rgba(0,0,0,0.7)",
      "border": "border.strong"
    }
  },
  "motion": {
    "$comment": "Kurz und beiläufig. Die Saison-Simulation ist die einzige Stelle mit bewusst längerer Animation.",
    "duration": {
      "instant": 80,
      "fast": 140,
      "base": 220,
      "slow": 360,
      "seasonTick": 650
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "spring": {
        "response": 0.35,
        "dampingFraction": 0.82
      }
    }
  },
  "component": {
    "card": {
      "radius": "lg",
      "padding": 16,
      "bg": "surface.1",
      "border": "border.subtle"
    },
    "segmentedControl": {
      "radius": "md",
      "height": 34,
      "bg": "surface.2",
